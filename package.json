{
  "name": "healthgo",
  "version": "1.0.0",
  "description": "HealthGo",
  "main": "main.cjs",
  "author": "HealthGo",
  "license": "ISC",
  "type": "commonjs",

  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },

  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },

  "build": {
    "appId": "com.healthgo.app",
    "productName": "HealthGo",

    "directories": {
      "output": "dist"
    },

    "files": [
      "main.cjs",
      "healthgo-ai-server.mjs",
      "www/**/*",
      "icon.png",
      "icon.ico",
      "package.json"
    ],

    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },

    "portable": {
      "artifactName": "HealthGo.exe"
    }
  }
}