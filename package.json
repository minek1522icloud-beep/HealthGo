{
  "name": "healthgo",
  "version": "1.1.0",
  "description": "HealthGo",
  "main": "main.cjs",
  "author": "HealthGo",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test tests/*.test.cjs",
    "check:syntax": "node scripts/check-syntax.cjs"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.healthgo.app",
    "productName": "HealthGo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "healthgo-ai-server.mjs",
      "www/**/*",
      "icon.png",
      "icon.ico",
      "package.json",
      "desktop-security.cjs"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HealthGo",
      "artifactName": "HealthGo-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "minek1522icloud-beep",
      "repo": "HealthGo"
    }
  }
}
